# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env

# Wallet Ethereum/Polygon (chave privada L1)
PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_AQUI

# API Key do Polymarket CLOB (gerada via assinatura L1)
# Deixe em branco na primeira execução — o bot gera automaticamente
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Endereço da wallet (público, sem risco)
WALLET_ADDRESS=0xSEU_ENDERECO_AQUI

# Modo de operação: dry_run ou live
MODE=dry_run

# Toggles de estratégia (true/false)
STRATEGY_A_ENABLED=true
STRATEGY_B1_ENABLED=true
STRATEGY_B2_ENABLED=true

# Exposição por estratégia (soma deve ser ≤ 1.0)
ALLOC_A=0.55
ALLOC_B1=0.20
ALLOC_B2=0.15
ALLOC_RSRV=0.10

# Máximo por operação em B1/B2 (% do capital total)
MAX_TRADE_B=0.05

